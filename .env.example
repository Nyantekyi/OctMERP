# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=DEBUG

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=erp_tenant_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_EXTERNAL_PORT=5432
DB_CONN_MAX_AGE=60

# ── Default Tenant Bootstrap ──────────────────────────────────────────────────
DEFAULT_TENANT_NAME="ERP Public"
DEFAULT_TENANT_SCHEMA=public
DEFAULT_TENANT_DOMAINS=localhost,127.0.0.1,backend
DEFAULT_TENANT_TRADE_COUNTRY=GH
DEFAULT_TENANT_CURRENCY=GHS

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=noreply@erp.app

# ── Storage (production only) ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
